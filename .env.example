# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://sync:sync@localhost:5432/messages

# --- Sync (beeper-pg-sync) --------------------------------------------------
# Beeper Desktop -> Settings -> Integrations: enable the Desktop API, then add an approved connection.
BEEPER_URL=http://127.0.0.1:23373
BEEPER_ACCESS_TOKEN=

# Optional: only sync these networks (comma separated), e.g. instagram,whatsapp
BEEPER_NETWORKS=
# Pages of older history fetched per chat per run (each page is one API call).
BEEPER_PAGES_PER_CHAT=4
# Ask self-hosted bridges for native thread IDs via Matrix room state.
BEEPER_RESOLVE_NATIVE_IDS=false

# Shared secret between the Chrome extension and the ingest server.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
INGEST_HOST=127.0.0.1
INGEST_PORT=8765

# Seconds between Beeper syncs in `beeper-pg-sync run`.
SYNC_INTERVAL=900

# --- Search (inbox-recall) --------------------------------------------------
# Embeddings: ollama | lmstudio | openai (any OpenAI-compatible API) | sentence-transformers | hash | none
EMBED_PROVIDER=ollama
# Defaults per provider: ollama nomic-embed-text, lmstudio text-embedding-nomic-embed-text-v1.5,
# openai text-embedding-3-small, sentence-transformers BAAI/bge-small-en-v1.5
EMBED_MODEL=
# Defaults: ollama http://127.0.0.1:11434/v1, lmstudio http://127.0.0.1:1234/v1, openai https://api.openai.com/v1
# In Docker Compose with the ollama profile use http://ollama:11434/v1; for Ollama on the host use
# http://host.docker.internal:11434/v1
EMBED_BASE_URL=
EMBED_API_KEY=
# Ask the API for shorter vectors (OpenAI text-embedding-3-*). HNSW indexes support up to 2000.
EMBED_DIMENSIONS=
EMBED_BATCH_SIZE=64
# Earlier messages from the same chat embedded with each message (0 to turn off).
EMBED_CONTEXT_MESSAGES=2
# Task prefixes some models expect. nomic-embed-text: "search_query: " / "search_document: ";
# e5: "query: " / "passage: ". Leave empty for OpenAI and bge.
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOCUMENT_PREFIX="search_document: "

# Time zone for "last spring" and for timestamps shown to agents (IANA name).
RECALL_TIMEZONE=
# Bearer token for the HTTP API and MCP over HTTP. Required unless bound to loopback.
RECALL_TOKEN=
RECALL_HOST=127.0.0.1
RECALL_PORT=8766
